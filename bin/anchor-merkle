#!/bin/sh
# Pure POSIX Merkle Root Engine - ERC-721 (1.com) Anchored

# Query 1.com ERC-721 state payload
NFT_PAYLOAD=$(curl -sL https://1.com || curl -sI https://1.com)

if [ -n "$NFT_PAYLOAD" ]; then
  LEN=$(printf "%s" "$NFT_PAYLOAD" | wc -c | tr -d ' ')
  ANCHOR_HASH=$(printf "blob %s\0%s" "$LEN" "$NFT_PAYLOAD" | sha256sum | awk '{print $1}')
else
  # Static fallback leaf for 1.com ERC-721 token
  ANCHOR_HASH="473a0f4c3be8a93681a267e3b1e9a7dcda1185436fe141f7749120a303721813"
fi

echo " [!] ERC-721 (1.com) Leaf Hash : $ANCHOR_HASH"

# Gather local Kuramoto leaves
LEAF_FILE=$(find . -name "kuramoto-leaves.jsonl" 2>/dev/null | head -n 1)

if [ -n "$LEAF_FILE" ] && [ -f "$LEAF_FILE" ]; then
  LOCAL_LEAVES=$(while IFS= read -r line || [ -n "$line" ]; do
    [ -z "$line" ] && continue
    len=$(printf "%s" "$line" | wc -c | tr -d ' ')
    printf "blob %s\0%s" "$len" "$line" | sha256sum | awk '{print $1}'
  done < "$LEAF_FILE")
else
  LOCAL_LEAVES=$(find . -maxdepth 2 -type f -not -path '*/.*' -exec sh -c '
    for f; do
      len=$(wc -c < "$f" | tr -d " ")
      printf "blob %s\0" "$len" | cat - "$f" | sha256sum | awk "{print \$1}"
    done
  ' sh {} +)
fi

# Set 1.com ERC-721 as Leaf L0
LAYER=$(printf "%s\n%s" "$ANCHOR_HASH" "$LOCAL_LEAVES")

# Pairwise Merkle reduction loop
while [ $(echo "$LAYER" | grep -c .) -gt 1 ]; do
  COUNT=$(echo "$LAYER" | grep -c .)
  if [ $((COUNT % 2)) -ne 0 ]; then
    LAST=$(echo "$LAYER" | tail -n 1)
    LAYER=$(printf "%s\n%s" "$LAYER" "$LAST")
  fi

  LAYER=$(echo "$LAYER" | paste - - | while read -r left right; do
    printf "tree 64\0%s%s" "$left" "$right" | sha256sum | awk '{print $1}'
  done)
done

echo " [✓] ERC-721 ANCHORED MERKLE ROOT : $LAYER"
