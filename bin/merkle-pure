#!/bin/sh

# Check if target file exists via argument or relative search
TARGET=""
if [ -n "$1" ] && [ -f "$1" ]; then
    TARGET="$1"
else
    TARGET=$(find . -name "kuramoto-leaves.jsonl" 2>/dev/null | head -n 1)
fi

if [ -n "$TARGET" ] && [ -f "$TARGET" ]; then
    LAYER=$(while IFS= read -r line || [ -n "$line" ]; do
        [ -z "$line" ] && continue
        printf "%s" "$line" | sha256sum | awk '{print $1}'
    done < "$TARGET")
else
    # Read from standard input stream
    LAYER=$(while IFS= read -r line || [ -n "$line" ]; do
        [ -z "$line" ] && continue
        printf "%s" "$line" | sha256sum | awk '{print $1}'
    done)
fi

if [ -z "$LAYER" ]; then
    echo "Error: No leaf data found." >&2
    exit 1
fi

# Pairwise hashing loop
while [ $(echo "$LAYER" | grep -c .) -gt 1 ]; do
    COUNT=$(echo "$LAYER" | grep -c .)
    if [ $((COUNT % 2)) -ne 0 ]; then
        LAST=$(echo "$LAYER" | tail -n 1)
        LAYER=$(printf "%s\n%s" "$LAYER" "$LAST")
    fi

    LAYER=$(echo "$LAYER" | paste - - | while read -r left right; do
        printf "%s%s" "$left" "$right" | xxd -r -p | sha256sum | awk '{print $1}'
    done)
done

echo "$LAYER"
