[2.229, "o", "\u001b[7mcat << 'EOF' > b\u001b[7mr\u001b[7moadcast_link.sh\u001b[27m\u001b[K\r\r\n\u001b[7m#!/bin/zsh\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mBOT_1=\"8989887535:AAGX4N1U18w1KrbkMX_cOr0Y90otZvD7qsc\"\u001b[27m\u001b[K\r\r\n\u001b[7mBOT_2=\"8276734769:AAGsGvk7eRfkYLS0ZOkgCFvxWgsx-7pq0-M\"\u001b[27m\u001b[K\r\r\n\u001b[7mBOT_3=\"8895929865:AAFVSR-ECLVlo63tqTts_0ZbkABJAAzdIWs\"\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mCHAT_ID=\"@Aiagency101tenet\"\u001b[27m\u001b[K\r\r\n\u001b[7mLINK=\"https://asciinema.org/a/GR4My0LlAPzVeWt7\"\u001b[27m\u001b[K\r\r\n\u001b[7mMESSAGE=\"🔴 [LIVE SOVEREIGN PROOF] Terminal recording captured and seale\u001b[7md\u001b[7m. Witness the raw mechanics here: $LINK\"\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mfor token in \"$BOT_1\" \"$BOT_2\" \"$BOT_3\"; do\u001b[27m\u001b[K\r\r\n\u001b[7m    curl -s -X POST \"https://api.telegram.org/bot${token}/sendMessage\" \\\u001b[27m \u001b[K\r\r\n\u001b[7m      -d \"chat_id=${CHAT_ID}\" \\\u001b[27m\u001b[K\r\r\n\u001b[7m      --data-urlencode \"text=$MESSAGE\" > /dev/null\u001b[27m\u001b[K\r\r\n\u001b[7mdone\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mprint \"Proof broadcasted to the channel across all bots.\"\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mchmod +x broadcast_link.sh\u001b[27m\u001b[K\r\r\n\u001b[7m./broadcast_link.sh\u001b[27m\u001b[K\r\r\n\u001b[K"]
