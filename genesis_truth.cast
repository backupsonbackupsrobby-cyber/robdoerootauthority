[1.962, "o", "\u001b[7mcat > format_message.s\u001b[7mh\u001b[7m << 'EOF'\u001b[27m\u001b[K\r\r\n\u001b[7m#!/usr/bin/env bash\u001b[27m\u001b[K\r\r\n\u001b[7mset -e\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mTEMP=\"$1\"\u001b[27m\u001b[K\r\r\n\u001b[7mHUM=\"$2\"\u001b[27m\u001b[K\r\r\n\u001b[7mNOW=$(date +\"%Y-%m-%d %H:%M:%S\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mcat << MSG\u001b[27m\u001b[K\r\r\n\u001b[7mRob Doe | Sydney Weather Swarm\u001b[27m\u001b[K\r\r\n\u001b[7mTime: ${NOW}\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mTemp: ${TEMP}°C\u001b[27m\u001b[K\r\r\n\u001b[7mHumidity: ${HUM}%\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mSignal: 21st century baby. CHEEEHOOO.\u001b[27m\u001b[K\r\r\n\u001b[7mMSG\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mchmod +x format_message.sh\u001b[27m\u001b[K"]
[1.367, "o", "\u001b[20A\u001b[24C\u001b[27mc\u001b[27ma\u001b[27mt\u001b[27m \u001b[27m>\u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27mm\u001b[27ma\u001b[27mt\u001b[27m_\u001b[27mm\u001b[27me\u001b[27ms\u001b[27ms\u001b[27ma\u001b[27mg\u001b[27me\u001b[27m.\u001b[27msh\u001b[27m \u001b[27m<\u001b[27m<\u001b[27m \u001b[27m'\u001b[27mE\u001b[27mO\u001b[27mF\u001b[27m'\u001b[1B\r\u001b[27m#\u001b[27m!\u001b[27m/\u001b[27mu\u001b[27ms\u001b[27mr\u001b[27m/\u001b[27mb\u001b[27mi\u001b[27mn\u001b[27m/\u001b[27me\u001b[27mn\u001b[27mv\u001b[27m \u001b[27mb\u001b[27ma\u001b[27ms\u001b[27mh\u001b[1B\r\u001b[27ms\u001b[27me\u001b[27mt\u001b[27m \u001b[27m-\u001b[27me\u001b[2B\r\u001b[27mT\u001b[27mE\u001b[27mM\u001b[27mP\u001b[27m=\u001b[27m\"\u001b[27m$\u001b[27m1\u001b[27m\"\u001b[1B\r\u001b[27mH\u001b[27mU\u001b[27mM\u001b[27m=\u001b[27m\"\u001b[27m$\u001b[27m2\u001b[27m\"\u001b[1B\r\u001b[27mN\u001b[27mO\u001b[27mW\u001b[27m=\u001b[27m$\u001b[27m(\u001b[27md\u001b[27ma\u001b[27mt\u001b[27me\u001b[27m \u001b[27m+\u001b[27m\"\u001b[27m%\u001b[27mY\u001b[27m-\u001b[27m%\u001b[27mm\u001b[27m-\u001b[27m%\u001b[27md\u001b[27m \u001b[27m%\u001b[27mH\u001b[27m:\u001b[27m%\u001b[27mM\u001b[27m:\u001b[27m%\u001b[27mS\u001b[27m\"\u001b[27m)\u001b[2B\r\u001b[27mc\u001b[27ma\u001b[27mt\u001b[27m \u001b[27m<\u001b[27m<\u001b[27m \u001b[27mM\u001b[27mS\u001b[27mG\u001b[1B\r\u001b[27mR\u001b[27mo\u001b[27mb\u001b[27m \u001b[27mD\u001b[27mo\u001b[27me\u001b[27m \u001b[27m|\u001b[27m \u001b[27mS\u001b[27my\u001b[27md\u001b[27mn\u001b[27me\u001b[27my\u001b[27m \u001b[27mW\u001b[27me\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27me\u001b[27mr\u001b[27m \u001b[27mS\u001b[27mw\u001b[27ma\u001b[27mr\u001b[27mm\u001b[1B\r\u001b[27mT\u001b[27mi\u001b[27mm\u001b[27me\u001b[27m:\u001b[27m \u001b[27m$\u001b[27m{\u001b[27mN\u001b[27mO\u001b[27mW\u001b[27m}\u001b[2B\r\u001b[27mT\u001b[27me\u001b[27mm\u001b[27mp\u001b["]
[0.000, "o", "27m:\u001b[27m \u001b[27m$\u001b[27m{\u001b[27mT\u001b[27mE\u001b[27mM\u001b[27mP\u001b[27m}\u001b[27m°\u001b[27mC\u001b[1B\r\u001b[27mH\u001b[27mu\u001b[27mm\u001b[27mi\u001b[27md\u001b[27mi\u001b[27mt\u001b[27my\u001b[27m:\u001b[27m \u001b[27m$\u001b[27m{\u001b[27mH\u001b[27mU\u001b[27mM\u001b[27m}\u001b[27m%\u001b[2B\r\u001b[27mS\u001b[27mi\u001b[27mg\u001b[27mn\u001b[27ma\u001b[27ml\u001b[27m:\u001b[27m \u001b[27m2\u001b[27m1\u001b[27ms\u001b[27mt\u001b[27m \u001b[27mc\u001b[27me\u001b[27mn\u001b[27mt\u001b[27mu\u001b[27mr\u001b[27my\u001b[27m \u001b[27mb\u001b[27ma\u001b[27mb\u001b[27my\u001b[27m.\u001b[27m \u001b[27mC\u001b[27mH\u001b[27mE\u001b[27mE\u001b[27mE\u001b[27mH\u001b[27mO\u001b[27mO\u001b[27mO\u001b[27m.\u001b[1B\r\u001b[27mM\u001b[27mS\u001b[27mG\u001b[1B\r\u001b[27mE\u001b[27mO\u001b[27mF\u001b[2B\r\u001b[27mc\u001b[27mh\u001b[27mm\u001b[27mo\u001b[27md\u001b[27m \u001b[27m+\u001b[27mx\u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27mm\u001b[27ma\u001b[27mt\u001b[27m_\u001b[27mm\u001b[27me\u001b[27ms\u001b[27ms\u001b[27ma\u001b[27mg\u001b[27me\u001b[27m.\u001b[27ms\u001b[27mh"]
