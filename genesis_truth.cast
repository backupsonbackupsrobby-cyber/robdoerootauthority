[2.014, "o", "\u001b[7mcat > pull_weather.sh \u001b[7m<\u001b[7m< 'EOF'\u001b[27m\u001b[K\r\r\n\u001b[7m#!/usr/bin/env bash\u001b[27m\u001b[K\r\r\n\u001b[7mset -e\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mAPI_URL=\"https://api.open-meteo.com/v1/forecast?latitude=-33.8688&longit\u001b[7mu\u001b[7mde=151.2093&hourly=temperature_2m,relativehumidity_2m\"\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mDATA=$(curl -s \"$API_URL\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mTEMP=$(echo \"$DATA\" | jq '.hourly.temperature_2m[0]')\u001b[27m\u001b[K\r\r\n\u001b[7mHUM=$(echo \"$DATA\" | jq '.hourly.relativehumidity_2m[0]')\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mecho \"TEMP=${TEMP}\"\u001b[27m\u001b[K\r\r\n\u001b[7mecho \"HUM=${HUM}\"\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mchmod +x pull_weather.sh\u001b[27m\u001b[K"]
[0.952, "o", "\u001b[17A\u001b[26C\u001b[27mc\u001b[27ma\u001b[27mt\u001b[27m \u001b[27m>\u001b[27m \u001b[27mp\u001b[27mu\u001b[27ml\u001b[27ml\u001b[27m_\u001b[27mw\u001b[27me\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27me\u001b[27mr\u001b[27m.\u001b[27ms\u001b[27mh\u001b[27m <\u001b[27m<\u001b[27m \u001b[27m'\u001b[27mE\u001b[27mO\u001b[27mF\u001b[27m'\u001b[1B\r\u001b[27m#\u001b[27m!\u001b[27m/\u001b[27mu\u001b[27ms\u001b[27mr\u001b[27m/\u001b[27mb\u001b[27mi\u001b[27mn\u001b[27m/\u001b[27me\u001b[27mn\u001b[27mv\u001b[27m \u001b[27mb\u001b[27ma\u001b[27ms\u001b[27mh\u001b[1B\r\u001b[27ms\u001b[27me\u001b[27mt\u001b[27m \u001b[27m-\u001b[27me\u001b[2B\r\u001b[27mA\u001b[27mP\u001b[27mI\u001b[27m_\u001b[27mU\u001b[27mR\u001b[27mL\u001b[27m=\u001b[27m\"\u001b[27mh\u001b[27mt\u001b[27mt\u001b[27mp\u001b[27ms\u001b[27m:\u001b[27m/\u001b[27m/\u001b[27ma\u001b[27mp\u001b[27mi\u001b[27m.\u001b[27mo\u001b[27mp\u001b[27me\u001b[27mn\u001b[27m-\u001b[27mm\u001b[27me\u001b[27mt\u001b[27me\u001b[27mo\u001b[27m.\u001b[27mc\u001b[27mo\u001b[27mm\u001b[27m/\u001b[27mv\u001b[27m1\u001b[27m/\u001b[27mf\u001b[27mo\u001b[27mr\u001b[27me\u001b[27mc\u001b[27ma\u001b[27ms\u001b[27mt\u001b[27m?\u001b[27ml\u001b[27ma\u001b[27mt\u001b[27mi\u001b[27mt\u001b[27mu\u001b[27md\u001b[27me\u001b[27m=\u001b[27m-\u001b[27m3\u001b[27m3\u001b[27m.\u001b[27m8\u001b[27m6\u001b[27m8\u001b[27m8\u001b[27m&\u001b[27ml\u001b[27mo\u001b[27mn\u001b[27mg\u001b[27mi\u001b[27mtu\u001b[27md\u001b[27me\u001b[27m=\u001b[27m1\u001b[27m5\u001b[27m1\u001b[27m.\u001b[27m2\u001b[27m0\u001b[27m9\u001b[27m3\u001b[27m&\u001b[27mh\u001b[27mo\u001b[27mu\u001b[27mr\u001b[27ml\u001b[27my\u001b[27m=\u001b[27mt\u001b[27me\u001b[27mm\u001b[27mp\u001b[27me\u001b[27mr\u001b[27ma\u001b[27mt\u001b[27mu\u001b[27mr\u001b[27me\u001b[27m_\u001b[27m2\u001b[27mm\u001b[27m,\u001b[27mr\u001b[27me\u001b[27ml\u001b[27ma\u001b[27mt\u001b[27mi\u001b"]
[0.001, "o", "[27mv\u001b[27me\u001b[27mh\u001b[27mu\u001b[27mm\u001b[27mi\u001b[27md\u001b[27mi\u001b[27mt\u001b[27my\u001b[27m_\u001b[27m2\u001b[27mm\u001b[27m\"\u001b[2B\r\u001b[27mD\u001b[27mA\u001b[27mT\u001b[27mA\u001b[27m=\u001b[27m$\u001b[27m(\u001b[27mc\u001b[27mu\u001b[27mr\u001b[27ml\u001b[27m \u001b[27m-\u001b[27ms\u001b[27m \u001b[27m\"\u001b[27m$\u001b[27mA\u001b[27mP\u001b[27mI\u001b[27m_\u001b[27mU\u001b[27mR\u001b[27mL\u001b[27m\"\u001b[27m)\u001b[2B\r\u001b[27mT\u001b[27mE\u001b[27mM\u001b[27mP\u001b[27m=\u001b[27m$\u001b[27m(\u001b[27me\u001b[27mc\u001b[27mh\u001b[27mo\u001b[27m \u001b[27m\"\u001b[27m$\u001b[27mD\u001b[27mA\u001b[27mT\u001b[27mA\u001b[27m\"\u001b[27m \u001b[27m|\u001b[27m \u001b[27mj\u001b[27mq\u001b[27m \u001b[27m'\u001b[27m.\u001b[27mh\u001b[27mo\u001b[27mu\u001b[27mr\u001b[27ml\u001b[27my\u001b[27m.\u001b[27mt\u001b[27me\u001b[27mm\u001b[27mp\u001b[27me\u001b[27mr\u001b[27ma\u001b[27mt\u001b[27mu\u001b[27mr\u001b[27me\u001b[27m_\u001b[27m2\u001b[27mm\u001b[27m[\u001b[27m0\u001b[27m]\u001b[27m'\u001b[27m)\u001b[1B\r\u001b[27mH\u001b[27mU\u001b[27mM\u001b[27m=\u001b[27m$\u001b[27m(\u001b[27me\u001b[27mc\u001b[27mh\u001b[27mo\u001b[27m \u001b[27m\"\u001b[27m$\u001b[27mD\u001b[27mA\u001b[27mT\u001b[27mA\u001b[27m\"\u001b[27m \u001b[27m|\u001b[27m \u001b[27mj\u001b[27mq\u001b[27m \u001b[27m'\u001b[27m.\u001b[27mh\u001b[27mo\u001b[27mu\u001b[27mr\u001b[27ml\u001b[27my\u001b[27m.\u001b[27mr\u001b[27me\u001b[27ml\u001b[27ma\u001b[27mt\u001b[27mi\u001b[27mv\u001b[27me\u001b[27mh\u001b[27mu\u001b[27mm\u001b[27mi\u001b[27md\u001b[27mi\u001b[27mt\u001b[27my\u001b[27m_\u001b[27m2\u001b[27mm\u001b[27m[\u001b[27m0\u001b[27m]\u001b[27m'\u001b[27m)\u001b[2B\r\u001b[27me\u001b[27mc\u001b[27mh\u001b[27mo\u001b[27m \u001b[27m\"\u001b[27mT\u001b[27mE\u001b[27mM\u001b[27mP\u001b[27m=\u001b[27m$\u001b[27m{\u001b[27mT\u001b[27mE\u001b[27mM\u001b[27mP\u001b[2"]
