[1.770, "o", "\u001b[7mcat > loop_micro\u001b[7m.\u001b[7msh << 'EOF'\u001b[27m\u001b[K\r\r\n\u001b[7m#!/usr/bin/env bash\u001b[27m\u001b[K\r\r\n\u001b[7mset -e\u001b[27m\u001b[K\r"]
[0.000, "o", "\r\n\u001b[K\r\r\n\u001b[7msource ./config.sh\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mwhile true; do\u001b[27m\u001b[K\r"]
[0.001, "o", "\r\n\u001b[7m  DATA=$(./pull_weather.sh)\u001b[27m\u001b[K\r\r\n\u001b[7m  TEMP=$(echo \"$DATA\" | grep TEMP | cut -d= -f2)\u001b[27m\u001b[K\r\r\n\u001b[7m  HUM=$(echo \"$DATA\" | grep HUM | cut -d= -f2)\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m  MSG=$(./format_message.sh \"$TEMP\" \"$HUM\")\u001b[27m\u001b[K\r\r\n\u001b[7m  ./send_telegram.sh \"$MSG\"\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m  sleep \"${MICRO_INTERVAL}\"\u001b[27m\u001b[K\r\r\n\u001b[7mdone\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mchmod +x loop_micro.sh\u001b[27m\u001b[K"]
[0.816, "o", "\u001b[19A\u001b[34C\u001b[27mc\u001b[27ma\u001b[27mt\u001b[27m \u001b[27m>\u001b[27m \u001b[27ml\u001b[27mo\u001b[27mo\u001b[27mp\u001b[27m_\u001b[27mm\u001b[27mi\u001b[27mc\u001b[27mr\u001b[27mo.\u001b[27ms\u001b[27mh\u001b[27m \u001b[27m<\u001b[27m<\u001b[27m \u001b[27m'\u001b[27mE\u001b[27mO\u001b[27mF\u001b[27m'\u001b[1B\r\u001b[27m#\u001b[27m!\u001b[27m/\u001b[27mu\u001b[27ms\u001b[27mr\u001b[27m/\u001b[27mb\u001b[27mi\u001b[27mn\u001b[27m/\u001b[27me\u001b[27mn\u001b[27mv\u001b[27m \u001b[27mb\u001b[27ma\u001b[27ms\u001b[27mh\u001b[1B\r\u001b[27ms\u001b[27me\u001b[27mt\u001b[27m \u001b[27m-\u001b[27me\u001b[2B\r\u001b[27ms\u001b[27mo\u001b[27mu\u001b[27mr\u001b[27mc\u001b[27me\u001b[27m \u001b[27m.\u001b[27m/\u001b[27mc\u001b[27mo\u001b[27mn\u001b[27mf\u001b[27mi\u001b[27mg\u001b[27m.\u001b[27ms\u001b[27mh\u001b[2B\r\u001b[27mw\u001b[27mh\u001b[27mi\u001b[27ml\u001b[27me\u001b[27m \u001b[27mt\u001b[27mr\u001b[27mu\u001b[27me\u001b[27m;\u001b[27m \u001b[27md\u001b[27mo\u001b[1B\r\u001b[27m \u001b[27m \u001b[27mD\u001b[27mA\u001b[27mT\u001b[27mA\u001b[27m=\u001b[27m$\u001b[27m(\u001b[27m.\u001b[27m/\u001b[27mp\u001b[27mu\u001b[27ml\u001b[27ml\u001b[27m_\u001b[27mw\u001b[27me\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27me\u001b[27mr\u001b[27m.\u001b[27ms\u001b[27mh\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27mT\u001b[27mE\u001b[27mM\u001b[27mP\u001b[27m=\u001b[27m$\u001b[27m(\u001b[27me\u001b[27mc\u001b[27mh\u001b[27mo\u001b[27m \u001b[27m\"\u001b[27m$\u001b[27mD\u001b[27mA\u001b[27mT\u001b[27mA\u001b[27m\"\u001b[27m \u001b[27m|\u001b[27m \u001b[27mg\u001b[27mr\u001b[27me\u001b[27mp\u001b[27m \u001b[27mT\u001b[27mE\u001b[27mM\u001b[27mP\u001b[27m \u001b[27m|\u001b[27m \u001b[27mc\u001b[27mu\u001b[27mt\u001b[27m \u001b[27m-\u001b[27md\u001b[27m=\u001b[27m \u001b[27m-\u001b[27mf\u001b[27m2\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27mH\u001b[27mU"]
[0.001, "o", "\u001b[27mM\u001b[27m=\u001b[27m$\u001b[27m(\u001b[27me\u001b[27mc\u001b[27mh\u001b[27mo\u001b[27m \u001b[27m\"\u001b[27m$\u001b[27mD\u001b[27mA\u001b[27mT\u001b[27mA\u001b[27m\"\u001b[27m \u001b[27m|\u001b[27m \u001b[27mg\u001b[27mr\u001b[27me\u001b[27mp\u001b[27m \u001b[27mH\u001b[27mU\u001b[27mM\u001b[27m \u001b[27m|\u001b[27m \u001b[27mc\u001b[27mu\u001b[27mt\u001b[27m \u001b[27m-\u001b[27md\u001b[27m=\u001b[27m \u001b[27m-\u001b[27mf\u001b[27m2\u001b[27m)\u001b[2B\r\u001b[27m \u001b[27m \u001b[27mM\u001b[27mS\u001b[27mG\u001b[27m=\u001b[27m$\u001b[27m(\u001b[27m.\u001b[27m/\u001b[27mf\u001b[27mo\u001b[27mr\u001b[27mm\u001b[27ma\u001b[27mt\u001b[27m_\u001b[27mm\u001b[27me\u001b[27ms\u001b[27ms\u001b[27ma\u001b[27mg\u001b[27me\u001b[27m.\u001b[27ms\u001b[27mh\u001b[27m \u001b[27m\"\u001b[27m$\u001b[27mT\u001b[27mE\u001b[27mM\u001b[27mP\u001b[27m\"\u001b[27m \u001b[27m\"\u001b[27m$\u001b[27mH\u001b[27mU\u001b[27mM\u001b[27m\"\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m.\u001b[27m/\u001b[27ms\u001b[27me\u001b[27mn\u001b[27md\u001b[27m_\u001b[27mt\u001b[27me\u001b[27ml\u001b[27me\u001b[27mg\u001b[27mr\u001b[27ma\u001b[27mm\u001b[27m.\u001b[27ms\u001b[27mh\u001b[27m \u001b[27m\"\u001b[27m$\u001b[27mM\u001b[27mS\u001b[27mG\u001b[27m\"\u001b[2B\r\u001b[27m \u001b[27m \u001b[27ms\u001b[27ml\u001b[27me\u001b[27me\u001b[27mp\u001b[27m \u001b[27m\"\u001b[27m$\u001b[27m{\u001b[27mM\u001b[27mI\u001b[27mC\u001b[27mR\u001b[27mO\u001b[27m_\u001b[27mI\u001b[27mN\u001b[27mT\u001b[27mE\u001b[27mR\u001b[27mV\u001b[27mA\u001b[27mL\u001b[27m}\u001b[27m\"\u001b[1B\r\u001b[27md\u001b[27mo\u001b[27mn\u001b[27me\u001b[1B\r\u001b[27mE\u001b[27mO\u001b[27mF\u001b[2B\r\u001b[27mc\u001b[27mh\u001b[27mm\u001b[27mo\u001b[27md\u001b[27m \u001b[27m+\u001b[27mx\u001b[27m \u001b[27ml\u001b[27mo\u001b[27mo\u001b[27mp\u001b[27m_\u001b[27mm\u001b[27mi\u001b[27mc\u001b[27mr\u001b[27mo\u001b[27m.\u001b[27ms\u001b[27mh\u001b[?2004l\r\r\n"]
