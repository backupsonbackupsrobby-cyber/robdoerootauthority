[1.021, "o", "\u001b[8A\u001b[53C\u001b[27mc\u001b[27ma\u001b[27mt\u001b[27m \u001b[27m>\u001b[27m \u001b[27mc\u001b[27mo\u001b[27mn\u001b[27mf\u001b[27mi\u001b[27mg\u001b[27m.\u001b[27ms\u001b[27mh\u001b[27m <\u001b[27m<\u001b[27m \u001b[27m'\u001b[27mE\u001b[27mO\u001b[27mF\u001b[27m'\u001b[1B\r\u001b[27mT\u001b[27mE\u001b[27mL\u001b[27mE\u001b[27mG\u001b[27mR\u001b[27mA\u001b[27mM\u001b[27m_\u001b[27mB\u001b[27mO\u001b[27mT\u001b[27m_\u001b[27mT\u001b[27mO\u001b[27mK\u001b[27mE\u001b[27mN\u001b[27m=\u001b[27m\"\u001b[27mY\u001b[27mO\u001b[27mU\u001b[27mR\u001b[27m_\u001b[27mB\u001b[27mO\u001b[27mT\u001b[27m_\u001b[27mT\u001b[27mO\u001b[27mK\u001b[27mE\u001b[27mN\u001b[27m_\u001b[27mH\u001b[27mE\u001b[27mR\u001b[27mE\u001b[27m\"\u001b[1B\r\u001b[27mT\u001b[27mE\u001b[27mL\u001b[27mE\u001b[27mG\u001b[27mR\u001b[27mA\u001b[27mM\u001b[27m_\u001b[27mC\u001b[27mH\u001b[27mA\u001b[27mT\u001b[27m_\u001b[27mI\u001b[27mD\u001b[27m=\u001b[27m\"\u001b[27mY\u001b[27mO\u001b[27mU\u001b[27mR\u001b[27m_\u001b[27mC\u001b[27mH\u001b[27mA\u001b[27mN\u001b[27mN\u001b[27mE\u001b[27mL\u001b[27m_\u001b[27mO\u001b[27mR\u001b[27m_\u001b[27mC\u001b[27mH\u001b[27mA\u001b[27mT\u001b[27m_\u001b[27mI\u001b[27mD\u001b[27m_\u001b[27mH\u001b[27mE\u001b[27mR\u001b[27mE\u001b[27m\"\u001b[2B\r\u001b[27m#\u001b[27m \u001b[27mu\u001b[27mp\u001b[27md\u001b[27ma\u001b[27mt\u001b[27me\u001b[27m \u001b[27mi\u001b[27mn\u001b[27mt\u001b[27me\u001b[27mr\u001b[27mv\u001b[27ma\u001b[27ml\u001b[27ms\u001b[27m \u001b[27m(\u001b[27ms\u001b[27me\u001b[27mc\u001b[27mo\u001b[27mn\u001b[27md\u001b[27ms\u001b[27m)\u001b[1B\r\u001b[27mM\u001b[27mI\u001b[27mC\u001b[27mR\u001b[27mO\u001b[27m_\u001b[27mI\u001b[27mN\u001b[27mT\u001b[27mE\u001b[27mR\u001b[27mV\u001b[27mA\u001b[27mL\u001b[27m=\u001b[27m1\u001b[27m2\u001b[27m9\u001b[27m6\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m#\u001b[27m \u001b[27m2\u001b[27m1\u001b[27mm\u001b[27m3\u001b[27m6\u001b[27ms\u001b[1B\r\u00