[1.830, "o", "\u001b[7mcat > send_telegram.sh\u001b[7m \u001b[7m<< 'EOF'\u001b[27m\u001b[K\r\r\n\u001b[7m#!/usr/bin/env bash\u001b[27m\u001b[K\r\r\n\u001b[7mset -e\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7msource ./config.sh\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mTEXT=\"$1\"\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mcurl -s -X POST \"https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendM\u001b[7me\u001b[7mssage\" \\\u001b[27m\u001b[K\r\r\n\u001b[7m  -d \"chat_id=${TELEGRAM_CHAT_ID}\" \\\u001b[27m\u001b[K\r\r\n\u001b[7m  -d \"text=${TEXT}\" \\\u001b[27m\u001b[K\r\r\n\u001b[7m  -d \"parse_mode=Markdown\" > /dev/null\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mchmod +x send_telegram.sh\u001b[27m\u001b[K"]
[1.255, "o", "\u001b[16A\u001b[25C\u001b[27mc\u001b[27ma\u001b[27mt\u001b[27m \u001b[27m>\u001b[27m \u001b[27ms\u001b[27me\u001b[27mn\u001b[27md\u001b[27m_\u001b[27mt\u001b[27me\u001b[27ml\u001b[27me\u001b[27mg\u001b[27mr\u001b[27ma\u001b[27mm\u001b[27m.\u001b[27ms\u001b[27mh \u001b[27m<\u001b[27m<\u001b[27m \u001b[27m'\u001b[27mE\u001b[27mO\u001b[27mF\u001b[27m'\u001b[1B\r\u001b[27m#\u001b[27m!\u001b[27m/\u001b[27mu\u001b[27ms\u001b[27mr\u001b[27m/\u001b[27mb\u001b[27mi\u001b[27mn\u001b[27m/\u001b[27me\u001b[27mn\u001b[27mv\u001b[27m \u001b[27mb\u001b[27ma\u001b[27ms\u001b[27mh\u001b[1B\r\u001b[27ms\u001b[27me\u001b[27mt\u001b[27m \u001b[27m-\u001b[27me\u001b[2B\r\u001b[27ms\u001b[27mo\u001b[27mu\u001b[27mr\u001b[27mc\u001b[27me\u001b[27m \u001b[27m.\u001b[27m/\u001b[27mc\u001b[27mo\u001b[27mn\u001b[27mf\u001b[27mi\u001b[27mg\u001b[27m.\u001b[27ms\u001b[27mh\u001b[2B\r\u001b[27mT\u001b[27mE\u001b[27mX\u001b[27mT\u001b[27m=\u001b[27m\"\u001b[27m$\u001b[27m1\u001b[27m\"\u001b[2B\r\u001b[27mc\u001b[27mu\u001b[27mr\u001b[27ml\u001b[27m \u001b[27m-\u001b[27ms\u001b[27m \u001b[27m-\u001b[27mX\u001b[27m \u001b[27mP\u001b[27mO\u001b[27mS\u001b[27mT\u001b[27m \u001b[27m\"\u001b[27mh\u001b[27mt\u001b[27mt\u001b[27mp\u001b[27ms\u001b[27m:\u001b[27m/\u001b[27m/\u001b[27ma\u001b[27mp\u001b[27mi\u001b[27m.\u001b[27mt\u001b[27me\u001b[27ml\u001b[27me\u001b[27mg\u001b[27mr\u001b[27ma\u001b[27mm\u001b[27m.\u001b[27mo\u001b[27mr\u001b[27mg\u001b[27m/\u001b[27mb\u001b[27mo\u001b[27mt\u001b[27m$\u001b[27m{\u001b[27mT\u001b[27mE\u001b[27mL\u001b[27mE\u001b[27mG\u001b[27mR\u001b[27mA\u001b[27mM\u001b[27m_\u001b[27mB\u001b[27mO\u001b[27mT\u001b[27m_\u001b[27mT\u001b[27mO\u001b[27mK\u001b[27mE\u001b[27mN\u001b[27m}\u001b[27m/\u001b[27ms\u001b[27me\u001b[27mn\u001b[27md\u001b[27mMe\u001b[27ms\u001b[27ms\u001b[27ma\u001b[27mg\u001b[27me\u001b[27m\"\u001b[27m \u001b[27m\\\u001b[1B\r\u001b[27m \u001b[27"]
