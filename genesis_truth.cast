[1.953, "o", ">....           \r\n\u001b[K\r\r\n\u001b[7m# Tail the log file in real time\u001b[27m\u001b[K\r\r\n\u001b[7mtail -Fn0 \"$LOG_FILE\" | while read -r line; do\u001b[27m\u001b[K\r\r\n\u001b[7m    # Check if the specific target email appears in the incoming attempt\u001b[7m \u001b[7mor log\u001b[27m\u001b[K\r\r\n\u001b[7m    if echo \"$line\" | grep -qi \"fabtecmetalworks@yahoo.com\"; then\u001b[27m\u001b[K\r\r\n\u001b[7m        \u001b[27m\u001b[K\r\r\n\u001b[7m        # If not already locked, apply the 1-year block state\u001b[27m\u001b[K\r\r\n\u001b[7m        if [ ! -f \"$LOCK_FILE\" ]; then\u001b[27m\u001b[K\r\r\n\u001b[7m            touch \"$LOCK_FILE\"\u001b[27m\u001b[K\r\r\n\u001b[7m            print \"[LOCKDOWN] Target identified: fabtecmetalworks@yahoo.\u001b[7mc\u001b[7mom. Password wiped. Locked out for 1 full year.\"\u001b[27m\u001b[K\r\r\n\u001b[7m            \u001b[27m\u001b[K\r\r\n\u001b[7m            (\u001b[27m\u001b[K\r\r\n\u001b[7m                # Run background timer to auto-lift after 1 year (315360\u001b[7m0\u001b[7m0 seconds)\u001b[27m\u001b[K\r\r\n\u001b[7m                sleep $BANTIME\u001b[27m\u001b[K\r\r\n\u001b[7m                rm -f \"$LOCK_FILE\"\u001b[27m\u001b[K\r\r\n\u001b[7m                print \"[RELEASE] 1-year penalty expired for fabtecmetalw\u001b[7mo\u001b[7mrks@yahoo.com.\"\u001b[27m\u001b[K\r\r\n\u001b[7m            ) &\u001b[27m\u001b[K\r\r\n\u001b[7m        else\u001b[27m\u001b[K\r\r\n\u001b[7m            print \"[BLOCKED] Hit from fabtecmetalworks@yahoo.com rejecte\u001b[7md\u001b[7m. Serving the 1-year lockout.\"\u001b[27m\u001b[K\r\r\n\u001b[7m        fi\u001b[27m\u001b[K\r\r\n\u001b[7m    fi\u001b[27m\u001b[K\r\r\n\u001b[7mdone\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mchmod +x email_sentinel.sh\u001b[27m\u001b[K\r\r\n\u001b[7m./email_sentinel.sh &\u001b[27m\u001b[K\r\r\n\u001b[K"]
